# Copy to deploy/.env before `docker compose up`.
# Public site used by Caddy and the Gateway origin allowlist.
SITE_ADDRESS=voice.example.com
CADDY_EMAIL=admin@example.com

# Reverse-proxy login for the operator console (/). /support stays public
# and is gated by SUPPORT_INBOUND_TOKEN. Empty HASH disables operator login
# (local/dev only). Generate hash:
# docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'your-password'
BASIC_AUTH_USER=operator
BASIC_AUTH_HASH=

# Must match the public HTTPS origin. Do not expose port 3101 on the host.
QWEN_AUDIO_AGENT_ALLOWED_ORIGINS=https://voice.example.com

# Cloud frontend-only default. Leave empty / none unless a backend already runs elsewhere.
AGENT_PROTOCOL=none
DASHSCOPE_API_KEY=
QWEN_AUDIO_REALTIME_PROVIDER=cascade

# Public /support inbound. Required before visitors can talk on /support?token=...
SUPPORT_INBOUND_TOKEN=

# Optional Feishu knowledge bypass. Management stays in WeKnora / document-buddy.
# KNOWLEDGE_PROVIDER=weknora
# WEKNORA_BASE_URL=http://weknora:8080
# WEKNORA_API_KEY=
# WEKNORA_KB_IDS=
# WEKNORA_FALLBACK_LOCAL=1
# MCP_SERVERS_JSON=
