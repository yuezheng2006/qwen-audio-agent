{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lingora",
  "version": "0.1.0",
  "identifier": "com.lingora.desktop",
  "build": {
    "frontendDist": "../../../web/dist",
    "devUrl": "http://127.0.0.1:5174",
    "beforeDevCommand": "npm --prefix ../.. run dev:web",
    "beforeBuildCommand": "npm --prefix ../.. run package:lingora-runtime && npm --prefix ../.. run build"
  },
  "app": {
    "windows": [
      {
        "title": "聆界 · Lingora",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../runtime": "runtime"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
